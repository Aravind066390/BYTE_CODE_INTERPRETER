impor*
VAR A=15
VAR B=30
VAR C=45
VAR D=60
VAR E=75
VAR F=90
VAR G=105
VAR H=120
VAR I=135
VAR J=150
VAR K=165
VAR L=180
TAN(A,A)
TAN(B,B)
TAN(C,C)
TAN(D,D)
TAN(F,F)
TAN(E,E)
TAN(G,G)
TAN(H,H)
TAN(I,I)
TAN(J,J)
TAN(K,K)
TAN(L,L)

A A*50
B B*50
C C*50
D D*50
E E*50
F F*50
G G*50
H H*50
I I*50
J J*50
K K*50
L L*50

YS GRAPHP(50,50,A,B,C,D,E,F,G,H,I,J,K,L)


@